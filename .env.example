# =============================================
# SevaSaathi — Environment Variables
# =============================================
# For LOCAL DEV: use MongoDB (replica set required)
#   DATABASE_URL=mongodb://localhost:27017/sevasaathi
#   Then run: bun run db:push && bun run seed
#
# For PRODUCTION (Render.com): use MongoDB Atlas
#   DATABASE_URL=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/sevasaathi?retryWrites=true&w=majority
#   Set this in the Render dashboard Environment section
# =============================================

# --- DATABASE ---
# Local dev: mongodb://localhost:27017/sevasaathi
# Production (MongoDB Atlas): mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/sevasaathi?retryWrites=true&w=majority
DATABASE_URL=mongodb://localhost:27017/sevasaathi

# --- AUTH ---
NEXTAUTH_SECRET=           # Random 32+ char string (e.g. openssl rand -base64 32)
NEXTAUTH_URL=https://your-app.onrender.com

# --- GOOGLE OAUTH ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- RAZORPAY (Payments) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- FIREBASE (Phone OTP) ---
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- BREVO (Email — free 300/day) ---
BREVO_API_KEY=
BREVO_SENDER_EMAIL=

# --- SMTP (Email Fallback — Gmail) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=                # Gmail App Password (16-char)

# --- FAST2SMS (Phone OTP SMS) ---
FAST2SMS_API_KEY=

# --- PLATFORM / BUSINESS ---
PLATFORM_UPI_ID=           # e.g. sevasaathi@razorpay
PLATFORM_UPI_NAME=SevaSaathi
PLATFORM_FEE_PERCENT=10
ADMIN_BANK_NAME=
ADMIN_ACCOUNT_NUMBER=
ADMIN_IFSC_CODE=
ADMIN_ACCOUNT_HOLDER=
