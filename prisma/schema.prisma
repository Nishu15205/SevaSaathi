// SevaSaathi - Verified Home Care & Elder Support Platform
// Database Schema — MongoDB

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS (stored as strings in MongoDB)
// ============================================================

// User roles
enum UserRole {
  FAMILY
  CAREGIVER
  ADMIN
}

// Verification document types
enum VerificationType {
  AADHAAR
  ID_CARD
  PAN
  DRIVING_LICENSE
  NURSING_CERTIFICATE
  MEDICAL_DEGREE
  POLICE_VERIFICATION
  ADDRESS_PROOF
  OTHER
}

// Verification status
enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

// Booking status
enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

// Shift types
enum ShiftType {
  DAY_SHIFT
  NIGHT_SHIFT
  TWELVE_HOUR
  TWENTY_FOUR_HOUR
  HOURLY
}

// Complaint status
enum ComplaintStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  DISMISSED
}

// Notification types
enum NotificationType {
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  CAREGIVER_ARRIVED
  CARE_REPORT_SUBMITTED
  REVIEW_REQUEST
  PAYMENT_RECEIVED
  VERIFICATION_UPDATE
  URGENT_REQUEST
  SYSTEM
}

// Care activity types for daily reports
enum CareActivityType {
  FEEDING
  BATHING
  HYGIENE
  MOBILITY
  MEDICINE
  EXERCISE
  COMPANIONSHIP
  VITAL_CHECK
  WOUND_CARE
  OTHER
}

// Subscription plans
enum SubscriptionPlan {
  NONE
  BASIC
  PREMIUM
  ENTERPRISE
}

// Payment status
enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

// Withdrawal status
enum WithdrawalStatus {
  PENDING
  APPROVED
  PROCESSING
  COMPLETED
  REJECTED
}

// ============================================================
// USER & AUTH
// ============================================================

model User {
  id             String           @id @default(auto()) @map("_id") @db.ObjectId
  email          String           @unique
  passwordHash   String?
  phone          String
  name           String
  role           UserRole
  avatarUrl      String?
  subscription   SubscriptionPlan @default(NONE)
  isActive       Boolean          @default(true)
  phoneVerified  Boolean          @default(false)
  otpSecret      String?
  lastLoginAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  // Relations
  patientProfiles  Patient[]
  caregiverProfile Caregiver?
  bookings         Booking[]
  payments         Payment[]
  reviews          Review[]
  complaints       Complaint[]
  notifications    Notification[]
  reviewedVerifications Verification[] @relation("VerificationReviewer")
  assignedComplaints    Complaint[] @relation("ComplaintAssignee")
  withdrawals           Withdrawal[]
}

// ============================================================
// PATIENT PROFILES (created by family members)
// ============================================================

model Patient {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  familyId        String   @db.ObjectId
  name            String
  age             Int
  gender          String
  relationship    String   // e.g., "mother", "father", "spouse"
  address         String
  city            String
  pincode         String?
  medicalHistory  String   // JSON string
  dietaryNeeds    String?
  mobilityStatus  String   @default("mobile") // mobile, bedridden, limited, wheelchair
  careRequirements String  // JSON string
  preferredLanguage String?
  emergencyContact String  // JSON: {name, phone, relation}
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  family    User      @relation(fields: [familyId], references: [id])
  bookings  Booking[]
}

// ============================================================
// CAREGIVER PROFILES
// ============================================================

model Caregiver {
  id              String          @id @default(auto()) @map("_id") @db.ObjectId
  userId          String          @unique @db.ObjectId
  gender          String?
  dateOfBirth     DateTime?
  address         String
  city            String
  pincode         String?
  latitude        Float?          // For geo-matching
  longitude       Float?
  yearsExperience Int             @default(0)
  qualifications  String          // JSON array: ["BSc Nursing", "GNM", etc.]
  skills          String          // JSON array: ["bedridden-care", "feeding", "wound-care", etc.]
  languages       String?         // JSON array: ["Hindi", "English", "Punjabi"]
  bio             String?
  hourlyRate      Int             // in INR
  availabilityJson String         // JSON: {mon: {day: true, night: false}, ...}
  overallRating   Float           @default(0)
  totalReviews    Int             @default(0)
  completedJobs   Int             @default(0)
  isVerified      Boolean         @default(false)
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  // Relations
  user          User           @relation(fields: [userId], references: [id])
  verifications Verification[]
  bookings      Booking[]
  careReports   CareReport[]
  reviews       Review[]
  payments      Payment[]
  complaints    Complaint[]
  withdrawals   Withdrawal[]
}

// ============================================================
// VERIFICATION DOCUMENTS
// ============================================================

model Verification {
  id           String            @id @default(auto()) @map("_id") @db.ObjectId
  caregiverId  String            @db.ObjectId
  docType      VerificationType
  docNumber    String
  docUrl       String            // stored file path or URL
  status       VerificationStatus @default(PENDING)
  reviewedBy   String?           @db.ObjectId // admin user ID
  reviewedAt   DateTime?
  rejectionReason String?
  expiresAt    DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  // Relations
  caregiver Caregiver @relation(fields: [caregiverId], references: [id])
  reviewer  User?    @relation("VerificationReviewer", fields: [reviewedBy], references: [id])
}

// ============================================================
// BOOKINGS
// ============================================================

model Booking {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  patientId      String        @db.ObjectId
  caregiverId    String        @db.ObjectId
  familyId       String        @db.ObjectId
  shiftType      ShiftType
  startDate      DateTime
  endDate        DateTime?
  startTime      String        // "20:00"
  endTime        String        // "08:00"
  careRequirements String       // JSON: specific needs for this booking
  status         BookingStatus @default(PENDING)
  familyNotes    String?
  caregiverNotes String?
  cancellationReason String?
  totalAmount    Int           @default(0) // in INR
  platformFee    Int           @default(0) // 10% commission
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // Relations
  patient    Patient    @relation(fields: [patientId], references: [id])
  caregiver  Caregiver  @relation(fields: [caregiverId], references: [id])
  family     User       @relation(fields: [familyId], references: [id])
  payment    Payment?
  careReports CareReport[]
  reviews    Review[]
  complaints Complaint[]
}

// ============================================================
// PAYMENTS
// ============================================================

model Payment {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  bookingId       String        @unique @db.ObjectId
  familyId        String        @db.ObjectId
  caregiverId     String        @db.ObjectId
  amount          Int           // total amount in paise
  platformFee     Int           @default(0)
  caregiverPayout Int           @default(0) // amount - platformFee
  status          PaymentStatus @default(PENDING)
  paymentMethod   String?       // "stripe", "upi", "bank_transfer", "cash"
  transactionId   String?
  upiId           String?
  paidAt          DateTime?
  refundedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  booking   Booking   @relation(fields: [bookingId], references: [id])
  family    User      @relation(fields: [familyId], references: [id])
  caregiver Caregiver @relation(fields: [caregiverId], references: [id])
}

// ============================================================
// CARE REPORTS (daily reports submitted by caregivers)
// ============================================================

model CareReport {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  bookingId  String   @db.ObjectId
  caregiverId String  @db.ObjectId
  reportDate String   // "2025-01-15"
  activities  String   // JSON array of care activities
  summary    String?
  mood       String?  @default("normal") // good, normal, upset, unwell
  foodIntake String?  @default("normal") // good, normal, poor, refused
  medicinesGiven String? // JSON: [{"name": "Metformin", "time": "08:00", "given": true}]
  concerns   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  booking   Booking   @relation(fields: [bookingId], references: [id])
  caregiver Caregiver @relation(fields: [caregiverId], references: [id])
}

// ============================================================
// REVIEWS
// ============================================================

model Review {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  bookingId   String   @unique @db.ObjectId
  familyId    String   @db.ObjectId
  caregiverId String   @db.ObjectId
  rating      Int      // 1-5
  communicationRating Int @default(0)
  punctualityRating   Int @default(0)
  careQualityRating   Int @default(0)
  comment     String?
  isPublished Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  booking   Booking   @relation(fields: [bookingId], references: [id])
  family    User      @relation(fields: [familyId], references: [id])
  caregiver Caregiver @relation(fields: [caregiverId], references: [id])
}

// ============================================================
// COMPLAINTS
// ============================================================

model Complaint {
  id          String          @id @default(auto()) @map("_id") @db.ObjectId
  bookingId   String?         @db.ObjectId
  familyId    String          @db.ObjectId
  caregiverId String          @db.ObjectId
  subject     String
  description String
  status      ComplaintStatus @default(OPEN)
  priority    String          @default("medium") // low, medium, high, urgent
  assignedTo  String?         @db.ObjectId // admin user ID
  resolution  String?
  resolvedAt  DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  // Relations
  booking   Booking?  @relation(fields: [bookingId], references: [id])
  family    User      @relation(fields: [familyId], references: [id])
  caregiver Caregiver  @relation(fields: [caregiverId], references: [id])
  assignee  User?     @relation("ComplaintAssignee", fields: [assignedTo], references: [id])
}

// ============================================================
// NOTIFICATIONS
// ============================================================

model Notification {
  id         String          @id @default(auto()) @map("_id") @db.ObjectId
  userId     String          @db.ObjectId
  type       NotificationType
  title      String
  message    String
  data       String?         // JSON: additional metadata
  isRead     Boolean         @default(false)
  createdAt  DateTime        @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id])
}

// ============================================================
// WITHDRAWALS (caregiver payout requests)
// ============================================================

model Withdrawal {
  id              String            @id @default(auto()) @map("_id") @db.ObjectId
  caregiverId     String            @db.ObjectId
  userId          String            @db.ObjectId
  amount          Int               // in paise
  method          String            @default("bank_transfer") // "bank_transfer", "upi"
  upiId           String?
  bankName        String?
  accountNumber   String?
  ifscCode        String?
  accountHolder   String?
  status          WithdrawalStatus  @default(PENDING)
  processedAt     DateTime?
  rejectionReason String?
  approvedBy      String?           @db.ObjectId
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  // Relations
  caregiver Caregiver @relation(fields: [caregiverId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}

// ============================================================
// SYSTEM CONFIG (backend-managed credentials & settings)
// ============================================================

model SystemConfig {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  section   String   // e.g., "GOOGLE_OAUTH", "RAZORPAY", "SMTP", "SMS", "PLATFORM"
  key       String   // e.g., "CLIENT_ID", "API_KEY", "SECRET"
  value     String   // The actual credential value
  label     String   // Display name, e.g., "Google Client ID"
  isSecret  Boolean  @default(true) // Hide value in UI
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([section, key])
}

// ============================================================
// OAUTH STATE (short-lived state tokens for OAuth flows)
// ============================================================

model OAuthState {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  stateToken  String   @unique // UUID passed to Google as state param
  role        String   @default("") // CAREGIVER, FAMILY, or empty
  redirectUrl String   // Full origin URL for post-auth redirect
  createdAt   DateTime @default(now())
  expiresAt   DateTime // 10 minutes from creation
}

// ============================================================
// EMAIL LOG (for tracking sent emails)
// ============================================================

model EmailLog {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  to          String
  subject     String
  body        String
  status      String   @default("sent") // sent, failed
  userId      String?  @db.ObjectId
  type        String?  // booking_confirmation, care_report, etc.
  externalId  String?  // Resend message ID
  createdAt   DateTime @default(now())
}
