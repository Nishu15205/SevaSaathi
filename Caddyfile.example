# ============================================
# SevaSaathi — Caddy Reverse Proxy
# ============================================
# Auto HTTPS + SSL. Just replace YOUR_DOMAIN.
#
# Install Caddy: apt install -y caddy
# Copy this file: cp Caddyfile.example /etc/caddy/Caddyfile
# Restart: systemctl restart caddy
# ============================================

# Replace with your domain (e.g., sevasaathi.in)
YOUR_DOMAIN.com {
    # Reverse proxy to Next.js
    reverse_proxy localhost:3000

    # Security headers
    header {
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    # File upload size limit (Razorpay webhook payload)
    request_body {
        max_size 10MB
    }
}

# HTTP redirect to HTTPS (automatic with Caddy)
# Also handle non-www → www redirect if needed
# www.YOUR_DOMAIN.com {
#     redir https://YOUR_DOMAIN.com{uri} permanent
# }